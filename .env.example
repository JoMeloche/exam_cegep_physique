# Copy to .env to change the defaults used by docker-compose.yml. Never commit .env.
# Image version from ghcr.io (latest, or a release such as 1.0.0)
EXAMGEN_VERSION=latest
EXAMGEN_PORT=8765
EXAMGEN_DATA=./mes_examens
TZ=America/Toronto

# 127.0.0.1 = this computer only. 0.0.0.0 = your network too (use HTTPS, see docs/securite.md).
EXAMGEN_BIND=127.0.0.1

# First administrator (optional). Leave empty to create it in the browser with the code printed by
# "docker compose logs examgen". You can remove the password from this file once the account exists.
EXAMGEN_ADMIN_EMAIL=
EXAMGEN_ADMIN_PASSWORD=

# per-user: each approved teacher has their own bank (and can share questions). shared: one common bank.
EXAMGEN_LIBRARY_MODE=per-user

# HTTPS with docker-compose.https.yml: your domain name.
EXAMGEN_DOMAIN=

# auto = Secure cookies when the request arrives over HTTPS. Set 1 behind any HTTPS proxy.
EXAMGEN_SECURE_COOKIES=auto
# Extra origins allowed to send requests (comma separated), only if your proxy changes the Host header.
EXAMGEN_TRUSTED_ORIGINS=
# Behind your own HTTPS proxy: its IP address, so login limits see the real visitor address.
FORWARDED_ALLOW_IPS=127.0.0.1
EXAMGEN_SESSION_IDLE_HOURS=24
EXAMGEN_SESSION_MAX_HOURS=168
